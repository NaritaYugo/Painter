#version 430 core
//COMMON_INCLUDE

// ---------------------------------------------------------------------------
// モザイクフィルターレイヤー 1パス目: ブロックごとの平均色を1テクセルに集約する
// ---------------------------------------------------------------------------
// 破壊的フィルター版(paint/mosaicReduce.comp)と全く同じ理由・同じ理屈(ブロック
// 内の全画素が同じ平均を重複計算しないよう、ブロック格子の側でディスパッチして
// 1ブロックにつき1回だけ平均を出す)。違いは、書き込み先が
// GLWidget::filterChainBlurScratch_(ガウスぼかしレイヤーの中間バッファと共用の
// キャンバスサイズのテクスチャ)の左上を間借りする点だけ(ブロック格子は
// キャンバス全面を覆うのに要る数なので、必ず収まる)。
// 2パス目(mosaicLayer.comp)がそれを引いて元の合成結果とブレンドする。
// ---------------------------------------------------------------------------
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) uniform readonly  image2D uSrc;
layout(rgba8, binding = 1) uniform writeonly image2D uBlocks; // 1テクセル = 1ブロックの平均色

uniform int uBlockSize; // モザイクの一辺(px)

void main() {
    ivec2 b  = ivec2(gl_GlobalInvocationID.xy); // ブロック格子上の位置
    ivec2 sz = imageSize(uSrc);

    ivec2 grid = (sz + uBlockSize - 1) / uBlockSize;
    if (b.x >= grid.x || b.y >= grid.y) return;

    ivec2 blockStart, blockEnd;
    resolveBlockRange(b * uBlockSize, uBlockSize, sz, blockStart, blockEnd);

    vec4 sum = vec4(0.0);
    int count = 0;
    for (int y = blockStart.y; y < blockEnd.y; ++y) {
        for (int x = blockStart.x; x < blockEnd.x; ++x) {
            sum += imageLoad(uSrc, ivec2(x, y));
            count++;
        }
    }
    imageStore(uBlocks, b, (count > 0) ? sum / float(count) : vec4(0.0));
}
