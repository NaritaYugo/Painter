#version 430 core
//COMMON_INCLUDE

// ---------------------------------------------------------------------------
// ノイズフィルターレイヤー
// ---------------------------------------------------------------------------
// 「これより下のレイヤーの合成結果」にフィルムグレインを足す、非破壊フィルター
// レイヤー用。乱数・粒の理屈は破壊的フィルター版(paint/noiseFilter.comp)と全く
// 同じ(コメント参照)。違いは chromaticAberrationLayer.comp 等と同じく、
// 「不透明度×レイヤーマスク」の強さで元の合成結果へブレンドして仕上げる点。
//
// 乱数の種(uSeed)はフィルターレイヤー生成時に1度だけ決めて FilterParams に
// 保持したものを毎フレームそのまま渡す(破壊的フィルター版がactivate()時に
// 1度だけ決めるのと同じ理由: 再合成のたびに振り直すと粒がチラチラする)。
// ---------------------------------------------------------------------------
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba8, binding = 0) uniform readonly  image2D uSrc; // ここまでの合成結果
layout(rgba8, binding = 1) uniform writeonly image2D uDst;

uniform float uAmount;     // ノイズの最大振れ幅(ストレート色の 0..1 スケール)
uniform int   uMonochrome; // 1=モノクロ(RGB共通のずれ), 0=カラー(チャンネルごとに独立)
uniform float uGrainPx;    // 粒の大きさ(px)
uniform uint  uSeed;

// 効果の強さ(フィルターレイヤーの不透明度)とレイヤーマスク。
// 引き方は chromaticAberrationLayer.comp / gaussianBlurLayer.comp と同じ。
uniform float uOpacity;
uniform int   uMaskBase;          // このフィルターレイヤー自身のマスク(-1なら無し)
uniform ivec4 uAncestorMaskBases; // 祖先フォルダー(最大4階層)のマスク(-1なら無し)
uniform int   uTileSize;
uniform int   uCanvasTilesX;

#define MAX_BANKS 8
uniform sampler2DArray layerTexBanks[MAX_BANKS];
uniform int uSlicesPerBank;
vec4 sampleTileArray(int si, vec2 uv) {
    int bank = si / uSlicesPerBank;
    float local = float(si - bank * uSlicesPerBank);
    for (int b = 0; b < MAX_BANKS; b++)
        if (b == bank) return textureLod(layerTexBanks[b], vec3(uv, local), 0.0);
    return vec4(0.0);
}

float sampleMaskSlice(int base, ivec2 canvasPx) {
    if (base < 0) return 1.0;
    int tx = canvasPx.x / uTileSize;
    int ty = canvasPx.y / uTileSize;
    vec2 tileOrigin = vec2(tx * uTileSize, ty * uTileSize);
    vec2 localUV = (vec2(canvasPx) + 0.5 - tileOrigin) / float(uTileSize);
    return sampleTileArray(base + ty * uCanvasTilesX + tx, localUV).r;
}

float maskAlphaAt(ivec2 canvasPx) {
    return sampleMaskSlice(uMaskBase, canvasPx)
         * sampleMaskSlice(uAncestorMaskBases.x, canvasPx)
         * sampleMaskSlice(uAncestorMaskBases.y, canvasPx)
         * sampleMaskSlice(uAncestorMaskBases.z, canvasPx)
         * sampleMaskSlice(uAncestorMaskBases.w, canvasPx);
}

// 整数ハッシュ(Chris Wellons の lowbias32 系ハッシュ。noiseFilter.compと同一)。
uint hashU(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float hash01(ivec2 p, int channel) {
    uint h = hashU(uint(p.x) * 73856093u ^ uint(p.y) * 19349663u
                 ^ uint(channel) * 83492791u ^ uSeed);
    return float(h) * (1.0 / 4294967296.0);
}

float valueNoise(vec2 p, int channel) {
    vec2  i = floor(p);
    vec2  f = fract(p);
    vec2  u = f * f * (3.0 - 2.0 * f);
    ivec2 ii = ivec2(i);
    float a = hash01(ii + ivec2(0, 0), channel);
    float b = hash01(ii + ivec2(1, 0), channel);
    float c = hash01(ii + ivec2(0, 1), channel);
    float d = hash01(ii + ivec2(1, 1), channel);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float noiseSigned(ivec2 coord, int channel) {
    float v = (uGrainPx <= 1.0)
        ? hash01(coord, channel)
        : valueNoise(vec2(coord) / uGrainPx, channel);
    return v * 2.0 - 1.0;
}

void main() {
    ivec2 c  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uSrc);
    if (c.x >= sz.x || c.y >= sz.y) return;

    vec4 orig = imageLoad(uSrc, c);
    vec3 straight = (orig.a > 0.0001) ? orig.rgb / orig.a : vec3(0.0);

    vec3 n;
    if (uMonochrome != 0) {
        float m = noiseSigned(c, 0);
        n = vec3(m);
    } else {
        n = vec3(noiseSigned(c, 0), noiseSigned(c, 1), noiseSigned(c, 2));
    }

    straight = clamp(straight + n * uAmount, 0.0, 1.0);
    vec4 noised = vec4(straight * orig.a, orig.a);

    float amount = clamp(uOpacity * maskAlphaAt(c), 0.0, 1.0);
    imageStore(uDst, c, mix(orig, noised, amount));
}
