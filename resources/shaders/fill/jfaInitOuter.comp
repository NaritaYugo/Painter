#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8,    binding = 3) uniform readonly  image2D wallTex;
layout(rg16f, binding = 4) uniform writeonly image2D jfaTex;

void main() {
    ivec2 coord   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(wallTex);
    if (coord.x >= texSize.x || coord.y >= texSize.y) return;

    float wall = imageLoad(wallTex, coord).r;

    // 壁ピクセル: シード座標として自分自身を書き込む
    // 非壁ピクセル: 未初期化を表す (-1, -1)
    vec2 seed = (wall > 0.5) ? vec2(coord) : vec2(-1.0);
    imageStore(jfaTex, coord, vec4(seed, 0.0, 0.0));
}
